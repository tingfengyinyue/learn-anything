# 复制为 .env 后修改；在哪个目录运行 `learn server` 就读哪个目录下的 .env

# ---- 数据库（默认 ~/.learn-anything/learn.db）----
# LA_DATABASE_URL=sqlite:////absolute/path/learn.db

# ---- 模型：anthropic | openai ----
LA_LLM_PROVIDER=anthropic
# Anthropic 官方默认 claude-opus-5-5；走第三方 Anthropic 兼容代理时，填代理那边的模型名
# LA_LLM_MODEL=claude-opus-5-5
# 凭据由 SDK 读取：ANTHROPIC_API_KEY（以及可选的 ANTHROPIC_BASE_URL）
# 旧模型（如 Haiku 4.5）不支持 adaptive thinking / effort 时：
# LA_ANTHROPIC_LEGACY=true
# 代理不支持服务端 fallback 时：
# LA_ANTHROPIC_FALLBACKS=false

# OpenAI 兼容接口示例（DeepSeek / 通义千问 / Ollama / vLLM ...）
# LA_LLM_PROVIDER=openai
# LA_LLM_MODEL=deepseek-chat
# LA_OPENAI_BASE_URL=https://api.deepseek.com/v1
# LA_OPENAI_API_KEY=sk-...
# 本地 Ollama：
# LA_OPENAI_BASE_URL=http://localhost:11434/v1
# LA_LLM_MODEL=qwen2.5:14b

# ---- 联网搜索：tavily | duckduckgo | none ----
# LA_SEARCH_PROVIDER=tavily
# LA_TAVILY_API_KEY=tvly-...
# DuckDuckGo 免 key，需要：pip install 'learn-anything[ddg]'
# LA_SEARCH_PROVIDER=duckduckgo

# ---- 多用户 ----
# 第一个注册的人自动成为管理员；之后关闭开放注册，由管理员 `learn admin add` 建号
# LA_ALLOW_SIGNUP=false
# 允许用户提交内网链接（默认禁止，防 SSRF）
# LA_ALLOW_PRIVATE_URLS=false

# ---- 群体层（跨用户沉淀与反思）----
# LA_BANK_RATIO=0.6           # 出题时优先从题库取题的概率，其余由模型结合群体经验新出
# LA_COLLECTIVE_MIN_USERS=2   # 误区 / 难度校准至少需要几个不同学习者的数据才生效；一个人试用设 1

# ---- 其他 ----
# LA_LANGUAGE=中文
# LA_FRESHNESS_DAYS=90        # 共享的主题层产出多少天后视为过期并重新生成
# LA_CONTEXT_CHARS=14000      # 每一步注入的资料片段上限
